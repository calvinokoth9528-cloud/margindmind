// Prisma schema for MarginMind
// Database models for e-commerce profit tracking

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  password      String
  stripeId      String?   @unique
  subscription  Subscription?
  settings      UserSettings?
  shops         Shop[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model UserSettings {
  id                 String   @id @default(cuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id])
  emailNotifications Boolean  @default(true)
  orderAlerts        Boolean  @default(true)
  weeklyReports      Boolean  @default(false)
  marketingEmails    Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Subscription {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id])
  stripeSubId     String?  @unique
  stripePriceId   String?
  status          String   @default("inactive")
  currentPeriodEnd DateTime?
  plan            String   @default("FREE")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Shop {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  platform        String
  shopUrl         String
  accessToken     String
  // Global commerce fields: country drives defaults (currency, VAT),
  // currency is what the shop's amounts are denominated in,
  // paymentProvider selects the fee profile used for profit math.
  country         String   @default("US")
  currency        String   @default("USD")
  paymentProvider String   @default("other")
  // Custom fee profile: when feePercent/feeFixed are set they override the
  // paymentProvider preset (useful for processors we don't cover).
  feePercent      Float? 
  feeFixed        Float?
  // Tax rate applied to revenue when computing pre/post-tax profit.
  // Percentage of order revenue; null = use the country default.
  taxRate         Float?
  orders          Order[]
  products        Product[]
  adSpendDays     AdSpendDay[]
  lastSync        DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, shopUrl])
}

model Product {
  id          String   @id @default(cuid())
  shopId      String
  shop        Shop     @relation(fields: [shopId], references: [id])
  externalId  String
  title       String
  sku         String?
  cost        Float    @default(0)
  price       Float    @default(0)
  imageUrl    String?
  orderItems  OrderItem[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([shopId, externalId])
}

model Order {
  id              String      @id @default(cuid())
  shopId          String
  shop            Shop        @relation(fields: [shopId], references: [id])
  externalId      String
  orderNumber     String
  totalRevenue    Float
  totalCost       Float       @default(0)
  shippingCost    Float       @default(0)
  transactionFee  Float       @default(0)
  taxAmount      Float       @default(0)
  adSpend         Float       @default(0)
  netProfit       Float       @default(0)
  profitMargin    Float       @default(0)
  status          String      @default("pending")
  // Refund tracking (null = not refunded)
  refundedAt      DateTime?
  refundAmount    Float       @default(0)
  refundReason    String?
  orderDate       DateTime
  items           OrderItem[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([shopId, externalId])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String?
  product   Product? @relation(fields: [productId], references: [id])
  quantity  Int
  price     Float
  cost      Float   @default(0)
  createdAt DateTime @default(now())
}

// Daily ad spend per shop, imported from ad platforms (Meta, Google Ads).
// Order.adSpend is a snapshot for fee/profit math; AdSpendDay is the
// canonical time series used to backfill order-level spend.
model AdSpendDay {
  id        String   @id @default(cuid())
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id])
  date      DateTime
  amount    Float
  source    String   @default("manual") // meta | google | manual
  createdAt DateTime @default(now())

  @@unique([shopId, date])
  @@index([shopId, date])
}
